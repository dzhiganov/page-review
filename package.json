{
  "name": "page-review",
  "version": "0.3.0",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "test": "node test/server.test.mjs && node test/e2e.mjs && AGENT_SYNC=1 node test/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:server": "node test/server.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "serve": "node server/serve.js",
    "mcp": "node server/mcp.js",
    "test:e2e:agent": "AGENT_SYNC=1 node test/e2e.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Chrome extension for reviewing web pages: draw and comment on any page, copy the review as an image or Markdown for an AI agent",
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  }
}
